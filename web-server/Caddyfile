# Cloud
cloud.farmacia.ufmg.br {
    import tlsConfig
    import maintenance
    reverse_proxy 10.10.10.5:443 {
        transport http {
            tls
            tls_server_name cloud.farmacia.ufmg.br
        }
    }
}

