# IP Definitions
(devClientsIp) {
    @devClientsIp {
        # remote_ip 150.164.110.253
        # remote_ip 179.0.74.126
        remote_ip 1.1.1.1
    }
}

(homolClientsIp) {
    @homolClientsIp {
        # IP whitelisting for homologation environments
        # remote_ip 150.164.110.33
        # remote_ip 150.164.110.42
        # remote_ip 150.164.110.52
        # remote_ip 150.164.111.211
        # remote_ip 150.164.111.219
        # remote_ip 150.164.111.121
        # remote_ip 150.164.111.200
        # remote_ip 150.164.111.36
        # remote_ip 150.164.111.60
        # remote_ip 150.164.111.199
        # remote_ip 150.164.111.19
        # remote_ip 150.164.110.88
        # remote_ip 150.164.110.65
        remote_ip 150.164.110.3
    }
}

# Common TLS configuration
(tlsConfig) {
    tls /etc/ssl/certs/farmacia/farmacia.ufmg.br.crt /etc/ssl/certs/farmacia/farmacia.ufmg.br.key
}

# Maintenance fallback handler
(maintenance) {
    handle_errors {
        root * /srv
        rewrite * /index.html
        file_server
    }
}

# Common reverse proxy configuration
(commonProxy) {
    import maintenance
    reverse_proxy 10.10.10.2:{args[0]} {
        lb_try_duration 5s
    }
}

# Common environment routing
(envRouting) {
    import devClientsIp
    import homolClientsIp
    
    handle @devClientsIp {
        reverse_proxy 10.10.10.4:{args[0]}
    }
    
    handle @homolClientsIp {
        reverse_proxy 10.10.10.3:{args[0]}
    }
}

# Main domain
farmacia.ufmg.br, www.farmacia.ufmg.br {
    import tlsConfig
    import envRouting 8001
    
    redir /Intranet https://intranet.farmacia.ufmg.br 301
    
    import commonProxy 8001
}

