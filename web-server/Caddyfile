# Stagemanager
stagemanager.farmacia.ufmg.br {
    import tlsConfig
    import envRouting 8004

    # Rota de Proxy para o Backend (/api/*)
    handle_path /api/* {
        reverse_proxy http://10.10.10.2:3001
    }

    import commonProxy 8004
}

