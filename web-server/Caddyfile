# Environment-specific TLS configuration
(tlsConfig) {
    import /etc/caddy/tls/{$CADDY_ENVIRONMENT:production}.caddy
}

# Maintenance fallback handler
(maintenance) {
    handle_errors {
        root * /srv
        rewrite * /index.html
        file_server
    }
}

# Common reverse proxy configuration
(commonProxy) {
    import maintenance
    reverse_proxy {args[0]} {
        lb_try_duration 5s
    }
}

# Main domain
farmacia.{$DOMAIN_SUFFIX:ufmg.br}, www.farmacia.{$DOMAIN_SUFFIX:ufmg.br} {
    import tlsConfig

    redir /Intranet https://intranet.farmacia.{$DOMAIN_SUFFIX:ufmg.br} 301

    import commonProxy institutional-website:80
}

# Intranet
intranet.farmacia.{$DOMAIN_SUFFIX:ufmg.br} {
    import tlsConfig
    import commonProxy intranet-website:80
}

# Escuta - Antigo c/ WordPress
escuta.farmacia.{$DOMAIN_SUFFIX:ufmg.br} {
    import tlsConfig
    import commonProxy escuta-website:80
}

# Legacy Escuta URL redirects to the current public URL.
nova-escuta.farmacia.{$DOMAIN_SUFFIX:ufmg.br} {
    import tlsConfig
    redir https://escuta.farmacia.{$DOMAIN_SUFFIX:ufmg.br}{uri} permanent
}

# Escuta - Ambiente de demonstração
stage-escuta.farmacia.{$DOMAIN_SUFFIX:ufmg.br} {
    import tlsConfig
    import commonProxy escuta-website-stage:80
}

# Stagemanager
stagemanager.farmacia.{$DOMAIN_SUFFIX:ufmg.br} {
